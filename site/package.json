{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://hydermohyuddin.com",
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "d3": "^7.9.0",
    "matter-js": "^0.20.0",
    "pdfjs-dist": "^3.4.120",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-flow-renderer": "^10.3.17",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^7.6.0",
    "react-scripts": "5.0.1",
    "three": "^0.182.0",
    "threejs-components": "^0.0.19",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node build-route-shells.mjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "echo Deploys run on GitHub Actions on every push to main that touches site/. Nothing to run here. Emergency manual path: npm run deploy:local && exit 1",
    "deploy:local": "npm run build && gh-pages -d build --nojekyll && npm run chat:deploy",
    "chat:secret:anthropic": "npx --yes wrangler@4 secret put ANTHROPIC_KEY",
    "test:chat": "node worker/chat-worker.test.mjs && node src/utils/chatActions.test.mjs",
    "chat:deploy": "node build-chat-knowledge.mjs && npx --yes wrangler@4 deploy",
    "chat:secret": "npx --yes wrangler@4 secret put GEMINI_KEY",
    "chat:kv": "npx --yes wrangler@4 kv namespace create CHAT_KV",
    "chat:tail": "npx --yes wrangler@4 tail",
    "chat:local": "node chat-dev-server.mjs",
    "chat:login": "npx --yes wrangler@4 login"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "meshoptimizer": "^1.2.0",
    "puppeteer": "^24.37.2",
    "puppeteer-screen-recorder": "^3.0.6"
  }
}
